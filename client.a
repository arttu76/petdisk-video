; PETdisk Video (PDV) PET client, machine code part.
; build.sh joins it with the BASIC loop in stub.bas.in.
; Each frame is received into a RAM buffer and then copied to the screen in
; about 20 ms, so frames do not tear. Bytes are read with an inline IEEE-488
; handshake (see the get macro), not with the kernal.

!cpu 6502
!ifndef DEV  { DEV  = 10 }
!ifndef COLS { COLS = 80 }
FRAME  = COLS * 25
SYNC   = $ff
ML     = $0800
SCREEN = $8000
BUF    = $1000                  ; frame buffer, FRAME bytes

CHKIN  = $ffc6
CLRCHN = $ffcc
CHRIN  = $ffcf
STOP   = $ffe1

; The BASIC part (stub.bas, tokenized by build.sh) opens VIDEO80 or VIDEO40 and
; calls this code. It returns when a key is pressed: KEYOUT holds the key,
; 0 for STOP. BASIC then sends the key to the server and reopens the video.
; It also returns when there is nothing to play (KEYOUT 83, as for S) and
; when the server stops (KEYOUT 0 and SRVSTOP 1).
KEYOUT = ML - 1
SRVSTOP = ML - 2                        ; 1: the server stopped
KBCOUNT = $9e                           ; keys in the keyboard buffer
KBBUF   = $026f                         ; keyboard buffer

; ---------------------------------------------------------------- machine code
; Stream format, all bytes read with the get macro:
;   $FF + FRAME screen codes            key frame
;   $FE + (skip, count, count codes)... + (0, 0)
;                                       delta frame: skip cells, then copy
;   $FD                                 padding, ignored
;   $FC                                 nothing to play: go to the search
;   $FA + 512-byte packets...           audio mode: sound, time and picture
;                                       until a key, LEAVE or $F9, see the
;                                       audio player below
;   $F9                                 the server stops: back to BASIC with
;                                       SRVSTOP set, BASIC ends PDV
;   $FB + (control, codes)...           run-length key frame, until FRAME
;                                       cells: control 0-127 is followed by
;                                       control + 1 literal codes, 128-255
;                                       by one code, repeated control - 126
;                                       times
; Frames are built in BUF and copied to the screen when complete.
KEY   = $ff
DELTA = $fe
SEARCH = $fc
RLE   = $fb
AUDIO = $fa
STOPPED = $f9
LEAVE = $ff                             ; audio mode, at a packet start: back
                                        ; to video frames

; IEEE-488 lines, as used by the BASIC 4 kernal byte-read routine at $F1C0
VIAPB  = $e840                          ; bit 1 NRFD out, bit 7 DAV in
IEEEIN = $e820                          ; data in, inverted
PIACRA = $e821                          ; $34 = NDAC low, $3c = NDAC high

; Read one byte from the talker into A, same handshake as the kernal but
; inline. Waits as long as needed for DAV and checks STOP while waiting.
; Uses Y.
!macro get {
        lda nrfdh
        sta VIAPB                       ; NRFD high: ready for data
-       bit VIAPB
        bpl +                           ; DAV low: data valid
        dec tmo
        bne -
        jsr chkstop
        jmp -
+       lda nrfdl
        sta VIAPB                       ; NRFD low
        lda IEEEIN
        eor #$ff
        ldy #$3c
        sty PIACRA                      ; NDAC high: accepted
        tay
-       bit VIAPB
        bpl -                           ; wait for DAV high
        lda #$34
        sta PIACRA                      ; NDAC low
        tya
}

* = ML
        jmp start                       ; SYS ML: play logical file 2
        jmp text                        ; SYS ML+3: show logical file 4

; logical file X becomes input, the drive becomes talker
listen  jsr CHKIN
        lda #$34
        sta PIACRA                      ; NDAC low
        lda VIAPB
        and #$fd
        sta nrfdl
        sta VIAPB                       ; NRFD low
        ora #$02
        sta nrfdh
        rts

; ---- text screen: FRAME screen codes straight into screen memory.
; The search screen comes this way: a known length, because the stock
; PETdisk firmware does not signal the end of a file opened with OPEN.
text    ldx #4
        jsr listen
        lda #<SCREEN
        sta tdst+1
        lda #>SCREEN
        sta tdst+2
        lda #<FRAME
        sta cnt
        lda #>FRAME
        sta cnt+1
tbyte   +get
tdst    sta SCREEN                      ; address patched
        inc tdst+1
        bne +
        inc tdst+2
+       lda cnt
        bne +
        dec cnt+1
+       dec cnt
        lda cnt
        ora cnt+1
        bne tbyte
        lda #255                        ; not STOP
        sta KEYOUT
        jmp CLRCHN

start   ldx #2
        jsr listen

next    lda KBCOUNT                     ; a key pressed?
        beq +
        lda KBBUF
        sta KEYOUT
        lda #0
        sta KBCOUNT
        jmp leave
+       jsr STOP                        ; Z=1 when STOP is pressed
        bne +
        jmp exit
+       +get
        cmp #KEY
        beq key
        cmp #DELTA
        bne +
        jmp delta
+       cmp #RLE
        bne +
        jmp rle
+       cmp #AUDIO
        bne +
        jmp audio
+       cmp #STOPPED
        bne +
        lda #1
        sta SRVSTOP
        jmp exit
+       cmp #SEARCH
        bne next                        ; padding or junk
        lda #83                         ; nothing to play: act as if S
        sta KEYOUT                      ; was pressed, BASIC shows search
        jmp leave

; ---- key frame: FRAME bytes into BUF
key     lda #<BUF
        sta kdst+1
        lda #>BUF
        sta kdst+2
        lda #<FRAME
        sta cnt
        lda #>FRAME
        sta cnt+1
kbyte   +get
kdst    sta BUF                         ; address patched
        inc kdst+1
        bne +
        inc kdst+2
+       lda cnt                         ; 16-bit countdown
        bne +
        dec cnt+1
+       dec cnt
        lda cnt
        ora cnt+1
        beq +
        jmp kbyte
+       jmp show

; ---- delta frame
delta   lda #<BUF
        sta ddst+1
        lda #>BUF
        sta ddst+2
run     +get                            ; skip
        sta skip
        +get                            ; count
        sta cnt
        ora skip
        bne +
        jmp show                        ; (0, 0) ends the frame
+
        clc
        lda ddst+1
        adc skip
        sta ddst+1
        bcc +
        inc ddst+2
+       lda ddst+2
        cmp #>(BUF + FRAME + 255)
        bcc +
        jmp next                        ; corrupt stream: drop this frame
+       lda cnt
        bne dbyte
        jmp run
dbyte   +get
ddst    sta BUF                         ; address patched
        inc ddst+1
        bne +
        inc ddst+2
        lda ddst+2
        cmp #>(BUF + FRAME + 255)
        bcc +
        jmp next                        ; corrupt stream: drop this frame
+       dec cnt
        beq +
        jmp dbyte
+       jmp run

; ---- run-length key frame: control bytes until FRAME cells are in BUF
rle     lda #<BUF
        sta rdst+1
        lda #>BUF
        sta rdst+2
        lda #<FRAME
        sta cnt
        lda #>FRAME
        sta cnt+1
rctl    +get                            ; control byte
        bmi rrep
        clc                             ; 0-127: control + 1 literal codes
        adc #1
        sta skip
rlit    +get
        jsr rput
        dec skip
        bne rlit
        beq rnext                       ; always
rrep    sec                             ; 128-255: one code, control - 126 times
        sbc #126
        sta skip
        +get
rrun    jsr rput
        dec skip
        bne rrun
rnext   lda cnt
        ora cnt+1
        beq +
        jmp rctl
+       jmp show

; store A at rdst and count the cell; a code past the end of the frame
; means a corrupt stream: drop the frame. Keeps A.
rput    ldy cnt
        bne +
        ldy cnt+1
        beq rbad
        dec cnt+1
+       dec cnt
rdst    sta BUF                         ; address patched
        inc rdst+1
        bne +
        inc rdst+2
+       rts
rbad    pla                             ; drop the return address
        pla
        jmp next

; ---- copy the finished frame to the screen
show    ldx #0
copy
!for p, 0, (FRAME / 256) - 1 {
        lda BUF + p * 256, x
        sta SCREEN + p * 256, x
}
        inx
        bne copy
!if FRAME % 256 {
        ldx #0
tail    lda BUF + (FRAME / 256) * 256, x
        sta SCREEN + (FRAME / 256) * 256, x
        inx
        cpx #FRAME % 256
        bne tail
}
        jmp next

exit    lda #0
        sta KEYOUT
leave   jsr CLRCHN
        rts

; STOP pressed while waiting for data: leave from inside the read macro
chkstop jsr STOP
        beq +
        rts
+       pla                             ; drop the return address
        pla
        jmp exit

; ---- audio player. After $FA the stream is packets of 512 bytes: DISP
; display bytes (TEXTW screen codes of the time or BUFFERING for the title
; on row 0, then a picture block of PICB bytes for the slide show), then
; sound: 8 bits a byte, bit 7 first, each bit 2 * (T2RATE + 2) cycles on
; CB2, which drives the speaker. The
; VIA shift register shifts the bits out under T2 control and sets IFR
; bit 2 when a byte is out; then the next byte goes in. A ring buffer
; covers the pauses of the PETdisk. Interrupts are off while the sound
; plays, so the 60 Hz keyboard interrupt cannot stop the shift register;
; the keyboard matrix is checked directly instead. When a key is down,
; the sound stops, interrupts go on, and the kernal reads the key.
VIASR  = $e84a
VIAACR = $e84b
VIAIFR = $e84d
VIAT2L = $e848
KBROW  = $e810                          ; PIA 1 port A: keyboard row 0-9
KBCOL  = $e812                          ; PIA 1 port B: columns, 0 = down
ABUF   = $1800                          ; ring buffer $1800-$3FFF; BASIC
AEND   = $4000                          ; keeps its strings below $1000
APAGES = (AEND - ABUF) / 256
ASTART = 16                             ; pages buffered before the sound
T2RATE = 19                             ; 42 cycles per bit: 23.8 kHz
SILENT = $00                            ; CB2 stays low: no sound
TEXTW  = 9                              ; the time or BUFFERING, on row 0
PICB   = 16                             ; picture block: commands with
                                        ; absolute positions, see dstep
PICEND = $ff                            ; ends a picture block early
DISP   = TEXTW + PICB                   ; display bytes at the packet start
SOUND  = 512 - DISP                     ; sound bytes in a packet
; the time field in the title "AUDIO MODE (1:23) - PRESS A FOR VIDEO"
; ("AUDIO (1:23) - A: VIDEO" on 40 columns), which the server centers on
; row 0: see AUDIO_TITLE in server.py
!if COLS = 80 {
TIMEX  = 31
} else {
TIMEX  = 13
}

audio   lda #<ABUF
        sta ard+1
        sta awr+1
        lda #>ABUF
        sta ard+2
        sta awr+2
        lda #0
        sta acnt
        sta acnt+1
        sta aplay
        sta apos
        sta apos+1
        sta dnew
        sta dphase
        sta pcnt
aresume sei
        lda VIAACR
        sta oldacr
        and #$e3
        ora #$14                        ; shift out under T2 control
        sta VIAACR
        lda #T2RATE
        sta VIAT2L
        lda #SILENT
        sta VIASR                       ; start shifting
        lda nrfdh
        sta VIAPB                       ; NRFD high: ready for data

aloop   lda VIAIFR                      ; 8 bits out?
        and #$04
        beq +
        jsr afeed
+       lda dnew                        ; a new packet plays: show it
        beq +
        jsr dstart
+       lda dphase                      ; one small drawing step
        beq +
        jsr dstep
+       inc akeyt                       ; the keyboard now and then
        bne +
        jsr akeys
+       lda acnt+1                      ; room in the buffer? Keep 3 pages
        cmp #APAGES - 3                 ; free behind the playing byte: the
        bcs aloop                       ; display bytes of the packet that
                                        ; plays (up to 512 bytes back) stay
                                        ; intact while dstep reads them
        bit VIAPB
        bmi aloop                       ; DAV high: no data yet
        lda nrfdl
        sta VIAPB                       ; NRFD low
        lda IEEEIN
        eor #$ff
        ldy awr+1                       ; a packet start? Packets are
        bne +                           ; 512-aligned in the ring, and
        tay                             ; ABUF is an even page
        lda awr+2
        lsr
        tya
        bcs +
        cmp #LEAVE                      ; the server switched back to video
        bne +
        jmp aleave
+
awr     sta ABUF                        ; address patched
        ldy #$3c
        sty PIACRA                      ; NDAC high: accepted
        inc awr+1
        bne +
        inc awr+2
        lda awr+2
        cmp #>AEND
        bne +
        lda #>ABUF
        sta awr+2
+       inc acnt
        bne +
        inc acnt+1
-
+       lda VIAIFR                      ; feed the sound while DAV goes high
        and #$04
        beq +
        jsr afeed
+       bit VIAPB
        bpl -                           ; wait for DAV high
        lda #$34
        sta PIACRA                      ; NDAC low
        lda nrfdh
        sta VIAPB                       ; NRFD high: ready for the next byte
        jmp aloop

; back to video frames: finish the handshake, sound off, interrupts on;
; the frames follow in the stream
aleave  ldy #$3c
        sty PIACRA                      ; NDAC high: accepted
-       lda VIAPB
        bpl -                           ; wait for DAV high
        lda #$34
        sta PIACRA                      ; NDAC low
        lda oldacr
        sta VIAACR                      ; sound off
        cli
        jmp next

; the next byte into the shift register: from the buffer, or silence
; until ASTART pages are buffered (at the start and after an underrun).
; At a packet start, the display bytes are noted for the main loop and
; skipped. Packets are 512-aligned in the ring, so DISP never crosses a
; page.
afeed   lda aplay
        bne afplay
        lda acnt+1
        cmp #ASTART
        bcs +
        jmp asilent                     ; still filling the buffer
+       inc aplay
afplay  lda apos
        ora apos+1
        bne asound
        lda acnt+1                      ; a packet starts: DISP + 1 bytes?
        bne +
        lda acnt
        cmp #DISP + 1
        bcc aunder
+       lda ard+1
        sta dptr
        lda ard+2
        sta dptr+1
        lda ard+1
        clc
        adc #DISP
        sta ard+1
        sec
        lda acnt
        sbc #DISP
        sta acnt
        bcs +
        dec acnt+1
+       lda #<SOUND
        sta apos
        lda #>SOUND
        sta apos+1
        lda #1
        sta dnew
asound  lda acnt
        ora acnt+1
        beq aunder
ard     lda ABUF                        ; address patched
        sta VIASR
        inc ard+1
        bne +
        inc ard+2
        lda ard+2
        cmp #>AEND
        bne +
        lda #>ABUF
        sta ard+2
+       lda acnt
        bne +
        dec acnt+1
+       dec acnt
        lda apos
        bne +
        dec apos+1
+       dec apos
        rts
aunder  lda #0
        sta aplay
asilent lda #SILENT
        sta VIASR
        rts

; any key down in the matrix? Feeds the sound between the rows.
akeys   ldx #9
-       lda VIAIFR
        and #$04
        beq +
        jsr afeed
+       stx KBROW
        lda KBCOL
        cmp #$ff
        bne akeydn
        dex
        bpl -
        rts
akeydn  pla                             ; drop the return address
        pla
        lda oldacr
        sta VIAACR                      ; sound off
        cli                             ; the kernal reads the key
        ldx #0                          ; wait up to about 0.4 s:
        ldy #40                         ; 40 x 256 x about 37 cycles
-       lda KBCOUNT
        bne akeyin
        jsr STOP
        bne +
        jmp exit                        ; RUN/STOP
+       dex
        bne -
        dey
        bne -
        jmp aresume                     ; no key after all: play on
akeyin  lda nrfdl
        sta VIAPB                       ; NRFD low: not ready
        lda KBBUF
        sta KEYOUT
        lda #0
        sta KBCOUNT
        jmp leave

; ---- the display of a packet: the text, then the picture block, one
; byte or one screen cell a step, each step short enough to feed the
; shift register on time. A picture command (positions 0-2047):
;   literal  (length - 1) << 3 | pos >> 8, pos & 255, length codes (1-14)
;   repeat   $80 | pos >> 8, pos & 255, count (1-255), code
dstart  lda #0
        sta dnew
        sta pidx
        sta pcnt                        ; a block stands alone
        lda dptr
        sta dtime+1
        clc
        adc #TEXTW                      ; packets are 512-aligned: no carry
        sta pblk+1
        lda dptr+1
        sta dtime+2
        sta pblk+2
        lda #1
        sta dphase
        rts

dstep   lda dphase
        cmp #1
        bne dpic
        ldx #TEXTW - 1
dtime   lda $ffff,x                     ; address patched: the text
        sta SCREEN + TIMEX,x
        dex
        bpl dtime
        inc dphase
        rts
dpic    lda pcnt                        ; a command in progress: one cell
        beq pnew
        lda prep
        bne +
        jsr pbyte                       ; literal: the next code
        jmp pcell
+       lda pcode                       ; repeat: the same code
pcell   jsr pput
        dec pcnt
        rts
pnew    lda pidx                        ; the next command of the block
        cmp #PICB
        bcs pdone
        jsr pbyte
        cmp #PICEND
        beq pdone
        sta phi
        and #7
        clc
        adc #>SCREEN
        sta pscr+1
        jsr pbyte
        sta pscr
        lda phi
        bmi prpt
        lsr
        lsr
        lsr
        clc
        adc #1                          ; length 1-14
        sta pcnt
        lda #0
        sta prep
        rts
prpt    jsr pbyte                       ; count
        sta pcnt
        jsr pbyte                       ; code
        sta pcode
        lda #1
        sta prep
        rts
pdone   lda #0
        sta dphase
        rts

; the next byte of the picture block into A
pbyte   ldx pidx
pblk    lda $ffff,x                     ; address patched
        inc pidx
        rts

; A into the screen at pscr, if pscr is inside the screen; then pscr + 1
pput    ldy pscr+1
        cpy #>(SCREEN + FRAME)
        bcc pok
        bne pskip
        ldy pscr
        cpy #<(SCREEN + FRAME)
        bcs pskip
pok     ldy pscr
        sty pw+1
        ldy pscr+1
        sty pw+2
pw      sta $ffff                       ; address patched
pskip   inc pscr
        bne +
        inc pscr+1
+       rts

dptr    !word 0                         ; the display bytes of the packet
dnew    !byte 0
dphase  !byte 0                         ; 0 idle, 1 text, 2 picture
pidx    !byte 0                         ; next byte of the picture block
pcnt    !byte 0                         ; cells left in the command
prep    !byte 0                         ; 1: repeat, 0: literal
pcode   !byte 0
phi     !byte 0
pscr    !word 0                         ; the screen cell to write next
apos    !word 0                         ; sound bytes left in the packet
acnt    !word 0
aplay   !byte 0
akeyt   !byte 0
oldacr  !byte 0
cnt     !word 0
skip    !byte 0
tmo     !byte 0
nrfdh   !byte 0
nrfdl   !byte 0
